# Supabase → Project Settings → API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# "service_role" key. SERVER ONLY — never expose it to the browser
# (no NEXT_PUBLIC_ prefix). It bypasses RLS, which is why the tables
# have RLS enabled with no policies: only this server can touch them.
SUPABASE_SERVICE_ROLE_KEY=

# Shared password for the login page
APP_PASSWORD=
# Random string >= 32 chars used to sign the session cookie
# generate: openssl rand -hex 32
SESSION_SECRET=

# Canonical site URL, used in metadata, JSON-LD and sitemap.xml.
# The code already defaults to this, so it only needs setting to override
# it (e.g. a staging domain).
NEXT_PUBLIC_SITE_URL=https://wulingjtgroup.com

# Demo pricing (master prompt Placeholder Rule, §38). No real prices are
# confirmed yet, so the calculator and PORTA configurator run on working,
# clearly-labeled demo numbers by default. Set to "false" once real prices
# are confirmed and every displayed amount becomes the placeholder ฿XXX,XXX
# until lib/data/vehicles.ts and lib/data/accessories.ts are updated with
# the real figures.
NEXT_PUBLIC_DEMO_PRICES=true

# Weekly sales report (/sales-report). All optional in dev — without the
# Google vars the page runs on demo leads and stores reports in .data/.
# Share the Google Sheet with the service account email as Editor.
SALES_REPORT_PASSCODE=
REPORT_SHEET_ID=1T4_PftBdWxSA0-l1Bc8csiMl2w4NkD5CPWb_07sM4uQ
GOOGLE_SERVICE_ACCOUNT_EMAIL=
